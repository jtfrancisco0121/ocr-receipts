    {
      "id": "e37de2bc-4d8e-5708-a849-c00505262ea5",
      "name": "Code: build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        280
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const batch = $('HTTP Request: Resibo extract').first().json;\nconst file = $('Google Drive Trigger').first().json;\nconst cfg = $('Set: config').first().json;\nconst s = batch.summary;\nconst flagged = batch.invoices.filter((inv) => inv.status !== 'OK');\nconst needsReview = s.documents === 0 || flagged.length > 0;\nconst subject = s.documents === 0\n  ? `Resibo: no invoices found — ${file.name}`\n  : `Resibo: ${s.documents} documents processed, ${s.review + s.error} need review — ${file.name}`;\nconst money = (value) => value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst excluding = s.total_excluding_errors_by_currency;\n// A server that predates the field sends no map: print the old all-documents line instead.\nconst totals = excluding == null\n  ? Object.entries(s.total_amount_by_currency)\n      .map(([currency, value]) => `${currency} ${value.toFixed(2)}`)\n      .join(', ') || 'n/a'\n  : Object.entries(s.total_amount_by_currency)\n      .map(([currency]) => `${currency} ${money(excluding[currency] ?? 0)}`)\n      .join(', ') || 'n/a';\nconst excludes = excluding != null && s.error > 0\n  ? ` (excludes ${s.error} ${s.error === 1 ? 'error' : 'errors'})`\n  : '';\nconst flaggedLines = flagged.map((inv) =>\n  `- ${inv.id} ${inv.seller_name ?? 'unknown seller'} (${inv.status}): ` +\n  inv.flags.map((flag) => flag.message).join('; '));\nconst body = [\n  `File: ${file.name}`,\n  `Documents: ${s.documents} (OK ${s.ok}, Review ${s.review}, Error ${s.error})`,\n  `Total: ${totals}${excludes}`,\n  '',\n  flaggedLines.length ? 'Needs attention:' : 'Nothing needs attention.',\n  ...flaggedLines,\n  '',\n  `Sheet: https://docs.google.com/spreadsheets/d/${cfg.sheet_id}`,\n  `Excel download (valid for 60 minutes): ${cfg.public_url}${batch.downloads.xlsx}`,\n  `Original file: ${file.webViewLink}`,\n].join('\\n');\nreturn [{ json: { subject, body, needsReview, documents: s.documents } }];\n"
      }
    },
