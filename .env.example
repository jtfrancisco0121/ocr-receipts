# Copy to .env and fill in. Never commit .env.

# Anthropic API key. Server-side only, never sent to the browser. Required (the app refuses
# to start without it).
ANTHROPIC_API_KEY=

# Model id. Switch to claude-haiku-4-5 for cost or claude-opus-5-5 for hard documents.
# Keep it a model listed in resibo/config.py PRICES: otherwise cost shows as null and the daily
# budget charges the highest known price.
CLAUDE_MODEL=claude-sonnet-5-5

# output_config.effort. Sent only to models that accept it (not Haiku 4.5). Raise to medium if
# eval accuracy needs it.
CLAUDE_EFFORT=low

# If set, requests with a matching X-API-Key skip the public limits. Used by n8n.
RESIBO_API_KEY=

# Reject uploads larger than this with 413.
MAX_UPLOAD_MB=20

# Hard page limit for keyed requests (keeps sequential runs inside the n8n timeout).
MAX_PAGES=30

# Which X-Forwarded-For entry is the client, counted from the right (1 = rightmost).
# Confirm at deploy: log the raw header once from two networks.
TRUSTED_PROXY_HOPS=1

# Page limit for anonymous (public demo) requests.
PUBLIC_MAX_PAGES=15

# Live extractions per IP per hour for anonymous requests (the cached sample does not count).
PUBLIC_RATE_LIMIT_PER_HOUR=5

# Global cap on estimated spend per UTC day for anonymous requests. When reached, public live
# runs return 503 DEMO_BUDGET_EXHAUSTED; the cached sample and keyed requests still work.
DAILY_BUDGET_USD=3.00

# Pages sent per Claude request.
PAGES_PER_CHUNK=10

# max_tokens per Claude request (requests are streamed). Thinking tokens count against this.
MAX_OUTPUT_TOKENS=16000

# How long batch results stay downloadable.
RESULT_TTL_MINUTES=60

# Peso tolerance for arithmetic checks.
AMOUNT_TOLERANCE=1.00

# Philippine VAT rate.
VAT_RATE=0.12

# Logging level.
LOG_LEVEL=INFO

# Set by Railway; 8000 locally.
PORT=8000
